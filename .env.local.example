# Gupta General Store — Comprehensive Environment Setup Guide
# Copy this to .env.local and fill in your actual credentials.

# ═══════════════════════════════════════════════════════════════
# 1. SUPABASE (Recommended Backend for Production)
# ═══════════════════════════════════════════════════════════════
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ═══════════════════════════════════════════════════════════════
# 2. OWNER / ADMIN PORTAL SECURITY
# ═══════════════════════════════════════════════════════════════
# Set your private admin portal password here:
ADMIN_PASSWORD=your_secure_admin_password_here

# 2-Step Verification (2FA) Security:
# Real OTP will be sent to this email upon password entry:
ADMIN_EMAIL=your_admin_email@gmail.com

# Emergency Master Recovery PIN (In case you lose email access or testing without SMTP):
ADMIN_BACKUP_KEY=123456

# ═══════════════════════════════════════════════════════════════
# 3. REAL EMAIL OTP (Gmail SMTP / Google App Password or Resend)
# ═══════════════════════════════════════════════════════════════
# 1. Open Google Account (myaccount.google.com) → Security
# 2. Turn ON 2-Step Verification
# 3. Search "App Passwords" → Create one for "Gupta Store"
# 4. Paste your 16-character App Password below:

EMAIL_USER=your_store_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM="Gupta General Store <your_store_email@gmail.com>"

# Alternative custom SMTP provider:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# Optional: Resend API
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# 4. TWILIO - For Real SMS OTP (Hindi/English SMS to customer's phone)
# ═══════════════════════════════════════════════════════════════
# Get these from: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════════════════
# 5. RAZORPAY - For Real Payment Processing
# ═══════════════════════════════════════════════════════════════
# Get these from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ═══════════════════════════════════════════════════════════════
# 6. APPLICATION BRANDING & INFO
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_STORE_NAME="Gupta General Store"
NEXT_PUBLIC_STORE_LOCATION="Bakani, Rajasthan"
NEXT_PUBLIC_STORE_PHONE="+91-8107615285"
