# Gupta General Store — Local Environment Setup Guide
# Copy this file to .env.local and configure your actual credentials.

# ═══════════════════════════════════════════════════════════════
# 1. SUPABASE (PostgreSQL Database, Storage & Row Level Security)
# ═══════════════════════════════════════════════════════════════
# Obtain these from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ═══════════════════════════════════════════════════════════════
# 2. OWNER ADMIN PORTAL SECURITY & 2-STEP VERIFICATION
# ═══════════════════════════════════════════════════════════════
# Private master password for logging into /admin:
ADMIN_PASSWORD=your_secure_admin_password_here

# Secret string used to sign admin session tokens (e.g. random 64-char hex string):
ADMIN_SECRET=your_admin_session_secret_hex_or_string

# Email address that receives the real 2FA OTP code on login:
ADMIN_EMAIL=your_admin_email@gmail.com

# Emergency master recovery PIN (fallback for test/offline verification):
ADMIN_BACKUP_KEY=123456

# ═══════════════════════════════════════════════════════════════
# 3. EMAIL DELIVERY (Nodemailer / Google App Password)
# ═══════════════════════════════════════════════════════════════
# Instructions for Gmail:
# 1. Open Google Account (myaccount.google.com) -> Security
# 2. Turn ON 2-Step Verification
# 3. Search "App Passwords" -> Create one for "Gupta Store"
# 4. Paste your 16-character App Password below:

EMAIL_USER=your_store_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM="Gupta General Store <your_store_email@gmail.com>"

# ═══════════════════════════════════════════════════════════════
# 4. STORE BRANDING & CONTACT INFO
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_STORE_NAME="Gupta General Store"
NEXT_PUBLIC_STORE_LOCATION="Bakani, Rajasthan"
NEXT_PUBLIC_STORE_PHONE="+91-8107615285"
